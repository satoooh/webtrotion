---
import PageLayout from "@/layouts/Base.astro";
import { getAllPages, getAllPosts, getPostContentByPostId, processFileBlocks } from "@/lib/notion/client";
import { extractTargetBlocks, getNavLink, getReferencesInPage, resetCurrentHeadings, resetFirstImage, setCurrentHeadings, setTrackCurrentPageId } from "@/lib/blog-helpers";
import NotionBlocks from "@/components/NotionBlocks.astro";
import type { Post } from "@/lib/interfaces";
import { siteInfo } from "@/siteInfo";
import { FULL_PREVIEW_COLLECTIONS, HIDE_UNDERSCORE_SLUGS_IN_LISTS, HOME_PAGE_SLUG, RECENT_POSTS_ON_HOME_PAGE, LAST_BUILD_TIME, BUILD_FOLDER_PATHS } from "@/constants";
import PostPreview from "@/components/blog/PostPreview.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { getFormattedDateWithTime } from "@/utils";
import Icon from "@/components/Icon.astro";
import { buildHeadings } from "@/utils";
import TOC from "@/components/blog/TOC.astro";
import fs from "fs/promises";
import path from "path";
import superjson from "superjson";
import { getNoteArticles } from "@/lib/note-rss";
import { getBlueskyPosts } from "@/lib/bluesky-posts";
import { atUriToPostUri, renderPostAsHtml } from "@/components/notion-blocks/embeds/astro-bluesky/utils";
import Embed from "@/components/notion-blocks/embeds/astro-bluesky/embed.astro";
import AnimatedSection from "@/components/AnimatedSection.astro";

export async function getStaticPaths() {
		const pages = await getAllPages();
		const allPosts = await getAllPosts();
    const allItems = [...pages, ...allPosts];
		const allItemsMap = Object.fromEntries(allItems.map(item => [item.PageId, item]));

		return pages.map((page) => {
				const referencesInPage = getReferencesInPage(page.PageId);
				const linkedPageIdsSet = new Set<string>();
				if (referencesInPage) {
						referencesInPage.forEach(ref => {
								if (ref.link_to_pageid) {
										linkedPageIdsSet.add(ref.link_to_pageid);
								}
								if (ref.other_pages) {
										ref.other_pages.forEach(richText => {
												if (richText.InternalHref?.PageId) {
														linkedPageIdsSet.add(richText.InternalHref.PageId);
												} else if (richText.Mention?.Page?.PageId) {
														linkedPageIdsSet.add(richText.Mention.Page.PageId);
												}
										});
								}
						});
				}
				const linkedPageIds = Array.from(linkedPageIdsSet);

				const pageLastUpdatedBeforeLastBuild =
						LAST_BUILD_TIME && page?.LastUpdatedTimeStamp
								? page.LastUpdatedTimeStamp < LAST_BUILD_TIME
								: false;

				const linkedPostsUpdated =
						!LAST_BUILD_TIME ||
						(linkedPageIds.length > 0 && linkedPageIds.some(pageId => {
								const linkedItem = allItemsMap[pageId];
								return linkedItem && linkedItem.LastUpdatedTimeStamp > LAST_BUILD_TIME;
						}));

				const shouldUseCache = pageLastUpdatedBeforeLastBuild && !linkedPostsUpdated;

				return {
						params: { page: page.Slug === HOME_PAGE_SLUG ? undefined : `/${page.Slug}` },
						props: { page, shouldUseCache, pageLastUpdatedBeforeLastBuild },
				};
		});
}

interface Props {
		page: Post;
		shouldUseCache: boolean;
		pageLastUpdatedBeforeLastBuild: boolean;
}

const { page: slug } = Astro.params;
const { page, shouldUseCache, pageLastUpdatedBeforeLastBuild } = Astro.props;

resetCurrentHeadings();

let pageFound = true;
let blocks = null;
let referencesInPage = null;
let headings = null;

if (!page) {
	console.log("Page not found");
	pageFound = false;
}

// --- HTML Cache ---
let cachedHtml = "";
// If the page was updated before the last build, try to read the cached HTML.
if (pageFound && shouldUseCache) {
		const cacheFilePath = path.join(BUILD_FOLDER_PATHS["blocksHtmlCache"], `${page.Slug}.html`);
		try {
				cachedHtml = await fs.readFile(cacheFilePath, "utf-8");
		} catch (e) {
				cachedHtml = "";
		}
}

// --- Headings Cache ---
let cachedHeadings = null;
const headingsCacheDir = BUILD_FOLDER_PATHS["headingsCache"];
const headingsCacheFile = path.join(headingsCacheDir, `${page.Slug}.json`);

if (pageFound && pageLastUpdatedBeforeLastBuild) {
	try {
		const headingsData = await fs.readFile(headingsCacheFile, "utf-8");
		cachedHeadings = superjson.parse(headingsData);
	} catch (e) {
		cachedHeadings = null;
	}
}

if (pageFound) {
		const result = await getPostContentByPostId(page);
		blocks = result.blocks;
		referencesInPage = result.referencesInPage;

		if (cachedHeadings) {
				headings = cachedHeadings;
		} else {
				headings = buildHeadings(blocks);
				try {
						await fs.writeFile(headingsCacheFile, superjson.stringify(headings), "utf-8");
				} catch (e) {
						console.error("Error saving headings cache:", e);
				}
		}
    setCurrentHeadings(headings);

    const fileAtacchedBlocks = extractTargetBlocks(["image","video","file","audio"], blocks)
        .filter((block) => {
            if (!block) {
                return false;
            }
            const imageOrVideoOrAudioOrFile = block.NImage || block.File || block.Video || block.NAudio;
            return (
                imageOrVideoOrAudioOrFile &&
                imageOrVideoOrAudioOrFile.File &&
                imageOrVideoOrAudioOrFile.File.Url
            );
        });
    await processFileBlocks(fileAtacchedBlocks);
}

let recent_posts = null;
let note_articles = null;
let bluesky_posts = null;

if (pageFound && page.Slug === HOME_PAGE_SLUG && RECENT_POSTS_ON_HOME_PAGE) {
		// 通常の投稿を取得
		recent_posts = await getAllPosts();
		recent_posts = recent_posts.filter((post) => !FULL_PREVIEW_COLLECTIONS.includes(post.Collection));
		if (HIDE_UNDERSCORE_SLUGS_IN_LISTS) {
				recent_posts = recent_posts.filter((post) => !post.Slug.startsWith("_"));
		}

		// note記事の取得
		try {
				note_articles = await getNoteArticles();
		} catch (error) {
				console.error("Error fetching note articles:", error);
				note_articles = [];
		}

		// Bluesky投稿の取得
		try {
				bluesky_posts = await getBlueskyPosts(5);
		} catch (error) {
				console.error("Error fetching bluesky posts:", error);
				bluesky_posts = [];
		}

		// TOCエントリの追加（表示タイトルと合わせる）
		if (headings && recent_posts && recent_posts.length > 0) {
			headings.push({
				text: "Recent Posts",
				slug: "auto-recent-posts",
				depth: 1,
			});
		}

		if (headings && note_articles && note_articles.length > 0) {
			headings.push({
				text: "note Posts",
				slug: "auto-note-posts",
				depth: 1,
			});
		}

		if (headings && bluesky_posts && bluesky_posts.length > 0) {
			headings.push({
				text: "Bluesky Posts",
				slug: "auto-bluesky-posts",
				depth: 1,
			});
		}

		// 表示件数制限（合計5件）
		recent_posts = recent_posts.slice(0, 5);
}
---

<style>
/* ホーム画面の洗練されたスタイル */

/* セクションのミニマルデザイン */
.home-section {
  margin-top: 5rem;
  padding: 0;
  border-bottom: 1px solid rgba(var(--theme-text), 0.08);
  padding-bottom: 2.5rem;
  transition: all 0.4s ease;
}

.dark .home-section {
  border-bottom-color: rgba(255, 255, 255, 0.06);
}

.home-section:last-child {
  border-bottom: none;
}

/* セクションタイトルの洗練されたデザイン */
.home-section-title {
  font-size: 1.125rem;
  font-weight: 600;
  letter-spacing: 0.025em;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 0.375rem;
  color: rgb(var(--theme-text));
  position: relative;
}

.home-section-title::after {
  content: '';
  position: absolute;
  bottom: -0.5rem;
  left: 0;
  width: 2rem;
  height: 1px;
  background: rgb(var(--theme-accent));
  opacity: 0.6;
}

.home-section-title svg {
  width: 1rem;
  height: 1rem;
  opacity: 0.7;
  color: rgb(var(--theme-accent));
}

/* 投稿リストのミニマルデザイン */
.post-card {
  padding: 1rem 0;
  border-bottom: 1px solid rgba(var(--theme-text), 0.04);
  transition: all 0.3s ease;
  position: relative;
}

.dark .post-card {
  border-bottom-color: rgba(255, 255, 255, 0.03);
}

.post-card:last-child {
  border-bottom: none;
}

.post-card:hover {
  transform: translateX(0.25rem);
  padding-left: 0.75rem;
}

.post-card:hover::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 2px;
  height: 60%;
  background: rgb(var(--theme-accent));
  opacity: 0.6;
  border-radius: 1px;
}

/* セクション別のアクセントカラー */
.note-section .post-card:hover::before {
  background: #10b981;
}

.bluesky-section .post-card:hover::before {
  background: #3b82f6;
}

/* もっと見るリンクの洗練されたスタイル */
.more-link {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  color: rgba(var(--theme-text), 0.6);
  font-weight: 500;
  font-size: 0.875rem;
  text-decoration: none;
  transition: all 0.2s ease;
  margin-top: 1.5rem;
  margin-bottom: 1rem;
  letter-spacing: 0.025em;
}

.more-link:hover {
  color: rgb(var(--theme-accent));
  gap: 0.5rem;
}

.more-link svg {
  width: 0.875rem;
  height: 0.875rem;
  transition: transform 0.2s ease;
}

.more-link:hover svg {
  transform: translateX(2px);
}

/* エントリーアニメーション - AnimatedSectionコンポーネントで処理 */

/* タイポグラフィの改善 */
.home-section h3 {
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 0.25rem;
}

.home-section time {
  font-size: 0.8125rem;
  opacity: 0.6;
  font-weight: 500;
  letter-spacing: 0.025em;
}

.home-section q {
  color: rgba(var(--theme-text), 0.7);
  font-size: 0.875rem;
  line-height: 1.5;
  margin-top: 0.25rem;
}

/* note/Bluesky投稿のシンプルなスタイル */
.note-section .post-card {
  position: relative;
}

.note-section .post-card::before {
  content: '';
  position: absolute;
  left: -0.25rem;
  top: 0;
  bottom: 0;
  width: 1px;
  background: #10b981;
  opacity: 0.2;
}

.bluesky-section .post-card {
  position: relative;
}

.bluesky-section .post-card::before {
  content: '';
  position: absolute;
  left: -0.25rem;
  top: 0;
  bottom: 0;
  width: 1px;
  background: #3b82f6;
  opacity: 0.2;
}

/* レスポンシブ調整 */
@media (max-width: 640px) {
  .home-section {
    margin-top: 3.5rem;
  }
  
  .home-section-title {
    font-size: 1rem;
  }
  
  .post-card:hover {
    transform: none;
    padding-left: 0;
  }
  
  .post-card:hover::before {
    display: none;
  }
}
</style>

{pageFound && resetFirstImage() && setTrackCurrentPageId(page.PageId) && (
		<PageLayout
				meta={{
						title: page.Title || siteInfo.title,
						description: page.Excerpt || siteInfo.description,
						ogImage: `/og-image/${page.Slug}.png`,
				}}
		>
				<div class="max-w-[708px] sm:mr-20 print:max-w-full print:mr-auto">
						<article class="break-words" data-pagefind-body>
								{shouldUseCache && cachedHtml ? (
										<div class="post-body" data-html-type="cached" set:html={cachedHtml}></div>
								) : (
										<div class="post-body" data-html-type="new">
												<NotionBlocks blocks={blocks} />
										</div>
								)}
								{headings && !!headings.length && <TOC headings={headings} />}
						</article>
				</div>
				{/* Recent Posts */}
				{RECENT_POSTS_ON_HOME_PAGE && recent_posts && (
						<AnimatedSection class="max-w-[708px] sm:mr-20 print:max-w-full print:mr-auto mt-8 home-section" animation="fadeInUp" delay={0}>
								<a href="#auto-recent-posts" id="auto-recent-posts" class="inline" onclick="var fullUrl = `${window.location.origin}${window.location.pathname}#${id}`; navigator.clipboard.writeText(fullUrl);">
										<h2 class="home-section-title hasId">
												<Icon name="document" class="w-6 h-6 text-[rgb(var(--theme-accent))]" />
												<strong>Recent Posts</strong>
										</h2>
								</a>
								<section aria-label="Recent posts list">
										<ul class="space-y-4 text-start">
												{recent_posts?.map((post, index) => (
														<li class="post-card">
																<AnimatedSection animation="fadeInUp" delay={index * 30}>
																		<PostPreview post={post} as="h3" withDesc />
																</AnimatedSection>
														</li>
												))}
										</ul>
										<AnimatedSection animation="fadeIn" delay={0}>
												<span class="mt-6 block sm:text-end">
														<a
																class="more-link"
																href={getNavLink("/posts/")}
																aria-label="View all posts"
														>
																全ての記事を見る
																<Icon name="mdi:open-in-new" class="w-4 h-4" />
														</a>
												</span>
										</AnimatedSection>
								</section>
						</AnimatedSection>
				)}

				{/* Recent Note Posts */}
				{page.Slug === HOME_PAGE_SLUG && note_articles && note_articles.length > 0 && (
						<AnimatedSection class="max-w-[708px] sm:mr-20 print:max-w-full print:mr-auto home-section note-section" animation="fadeInUp" delay={0}>
								<a href="#auto-note-posts" id="auto-note-posts" class="inline" onclick="var fullUrl = `${window.location.origin}${window.location.pathname}#${id}`; navigator.clipboard.writeText(fullUrl);">
										<h2 class="home-section-title hasId">
												<svg class="w-6 h-6 text-green-600 dark:text-green-400" viewBox="0 0 24 24" fill="currentColor">
														<path d="M20.71 7.04c.39-.39.39-1.04 0-1.41l-2.34-2.34c-.37-.39-1.02-.39-1.41 0l-1.84 1.83l3.75 3.75M3 17.25V21h3.75L17.81 9.93l-3.75-3.75L3 17.25z"/>
												</svg>
												<strong>note Posts</strong>
										</h2>
								</a>
								<section aria-label="note Posts list">
										<ul class="space-y-3 text-start">
												{note_articles?.slice(0, 5)?.map((article, index) => (
														<li class="post-card">
																<AnimatedSection animation="fadeInUp" delay={index * 30}>
																		<FormattedDate date={new Date(article.pubDate)} class="text-green-600 dark:text-green-400 text-xs" />
																		<div>
																				<a
																						href={article.link}
																						class="animated-link font-semibold hover:text-green-600 dark:hover:text-green-400 transition-colors"
																						target="_blank"
																						rel="noopener noreferrer"
																				>
																						{article.title}
																				</a>
																		</div>
																		{article.description && (
																				<q class="line-clamp-2 block text-sm text-[rgb(var(--theme-text)_/_0.8)] mt-1 italic">{article.description}</q>
																		)}
																</AnimatedSection>
														</li>
												))}
										</ul>
										<AnimatedSection animation="fadeIn" delay={0}>
												<span class="mt-6 block sm:text-end">
														<a
																class="more-link"
																href="https://note.com/satoooh"
																target="_blank"
																rel="noopener noreferrer"
																aria-label="View all note articles"
														>
																noteの記事をもっと見る
																<Icon name="mdi:open-in-new" class="w-4 h-4" />
														</a>
												</span>
										</AnimatedSection>
								</section>
						</AnimatedSection>
				)}

				{/* Recent Bluesky Posts */}
				{page.Slug === HOME_PAGE_SLUG && bluesky_posts && bluesky_posts.length > 0 && (
						<AnimatedSection class="max-w-[708px] sm:mr-20 print:max-w-full print:mr-auto home-section bluesky-section" animation="fadeInUp" delay={0}>
								<a href="#auto-bluesky-posts" id="auto-bluesky-posts" class="inline" onclick="var fullUrl = `${window.location.origin}${window.location.pathname}#${id}`; navigator.clipboard.writeText(fullUrl);">
										<h2 class="home-section-title hasId">
												<Icon name="bluesky" class="w-6 h-6 text-blue-500" />
												<strong>Bluesky Posts</strong>
										</h2>
								</a>
								<section aria-label="Bluesky Posts list">
										<ul class="space-y-3 text-start">
												{bluesky_posts?.slice(0, 5)?.map((post, index) => {
														const postUrl = atUriToPostUri(post.uri);
														const postText = renderPostAsHtml(post);
														return (
																<li class="post-card">
																		<AnimatedSection animation="fadeInUp" delay={index * 30}>
																				<div class="flex items-start gap-3">
																				{post.author?.avatar && (
																						<img src={post.author.avatar} alt={post.author.displayName} class="w-10 h-10 rounded-full object-cover ring-2 ring-blue-200 dark:ring-blue-800" />
																				)}
																				<div class="flex-1 min-w-0">
																						<div class="flex items-center gap-1 text-sm">
																								<span class="font-semibold text-blue-900 dark:text-blue-100">{post.author?.displayName}</span>
																								<span class="text-blue-600 dark:text-blue-400">@{post.author?.handle}</span>

																						{post.indexedAt && (
																							<span class="text-blue-500 dark:text-blue-400 text-xs ml-auto">
																								<time datetime={new Date(post.indexedAt).toISOString()}>
																										{new Intl.DateTimeFormat('ja-JP', {
																											year: 'numeric',
																											month: 'short',
																											day: 'numeric',
																											hour: '2-digit',
																											minute: '2-digit',
																											timeZone: 'Asia/Tokyo'
																										}).format(new Date(post.indexedAt))}
																									</time>
																							</span>
																						)}
																						</div>
																						<div class="mt-2 text-sm line-clamp-3" set:html={postText} />
																					{post.embed && (
																							<div class="mt-2 max-w-full overflow-hidden rounded-md">
																									<div class="max-h-48 sm:max-h-64 overflow-hidden">
																											<Embed embed={post.embed} postUrl={postUrl} compact={true} />
																									</div>
																							</div>
																					)}
																						<a href={postUrl} target="_blank" rel="noopener noreferrer" class="mt-3 text-blue-600 dark:text-blue-400 text-xs inline-flex items-center hover:gap-2 transition-all duration-200">
																								<Icon
																										name="external-link-mention"
																										class="inline-block w-3 h-3 mr-1"
																										aria-hidden="true"
																								/>
																								Blueskyで見る
																						</a>
																				</div>
																		</div>
																		</AnimatedSection>
																</li>
														);
												})}
										</ul>
										<AnimatedSection animation="fadeIn" delay={0}>
												<span class="mt-6 block sm:text-end">
														<a
																class="more-link"
																href="https://bsky.app/profile/satoooh.org"
																target="_blank"
																rel="noopener noreferrer"
																aria-label="View Bluesky profile"
														>
																Blueskyをもっと見る
																<Icon name="mdi:open-in-new" class="w-4 h-4" />
														</a>
												</span>
										</AnimatedSection>
								</section>
						</AnimatedSection>
				)}
		</PageLayout>

		<button
				id="to-top-btn"
				class="cursor-pointer z-30 fixed print:hidden bottom-20 sm:bottom-8 end-4 flex h-10 w-10 translate-y-28 items-center justify-center rounded-full border-2 border-transparent bg-zinc-200 text-3xl opacity-0 transition-all duration-300 hover:border-zinc-400 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 dark:bg-zinc-700 sm:end-8 sm:h-12 sm:w-12"
				aria-label="Back to Top"
				data-show="false"
		>
				<Icon name={"to-top"} class="h-6 w-6" aria-label="Go Back to Top" stroke-linecap="round" />
		</button>

		<script>
				document.addEventListener("DOMContentLoaded", function () {
						const scrollBtn = document.getElementById("to-top-btn");
						const targetHeader = document.getElementById("main-header");
						function callback(entries) {
								entries.forEach((entry) => {
										scrollBtn.dataset.show = (!entry.isIntersecting).toString();
								});
						}
						scrollBtn.addEventListener("click", () => {
								document.documentElement.scrollTo({ top: 0, behavior: "smooth" });
						});
						const observer = new IntersectionObserver(callback);
						observer.observe(targetHeader);
				});
		</script>
)}