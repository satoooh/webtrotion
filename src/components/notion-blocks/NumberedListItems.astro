---
import * as interfaces from "@/lib/interfaces.ts";
import { getNotionColorToTailwindColor } from "@/lib/style-helpers.ts";
import RichText from "@/components/notion-blocks/RichText.astro";
import NotionBlocks from "@/components/NotionBlocks.astro";

export interface Props {
	block: interfaces.Block;
	level: number;
	renderChildren?: boolean; // Make this optional
	setId?: boolean;
}

const { block, level, renderChildren = true, setId = true } = Astro.props;

const listTypes = ["lower-roman", "decimal", "lower-alpha"];
---

<div class="numbered-list my-6" id={setId ? block.Id : undefined}>
	<ol
		class="list-outside list-none space-y-3 pl-6 counter-reset-list"
		style={`list-style-type: ${listTypes[level % 3]} !important;`}
	>
		{
			block.ListItems.filter((b: interfaces.Block) => b.Type === "numbered_list_item").map(
				(b: interfaces.Block, index: number) => (
					<li
						class:list={[
							"numbered-item relative pl-8 transition-all duration-300 hover:translate-x-1",
							{
								[`${getNotionColorToTailwindColor(b.NumberedListItem.Color)} rounded-sm px-2 py-1`]:
									b.NumberedListItem.Color &&
									!["default", "default_background", "default-background"].includes(
										b.NumberedListItem.Color,
									),
							},
						]}
						id={setId ? b.Id : undefined}
						data-index={index + 1}
					>
						{b.NumberedListItem.RichTexts.map((richText: interfaces.RichText) => (
							<RichText richText={richText} blockID={b.Id} />
						))}
						{b.HasChildren && renderChildren && (
							<NotionBlocks
								blocks={b.NumberedListItem.Children}
								level={level + 1}
								renderChildren={renderChildren}
								setId={setId}
							/>
						)}
					</li>
				),
			)
		}
	</ol>
</div>

<style>
	/* カスタム番号スタイル */
	.counter-reset-list {
		counter-reset: list-counter;
	}
	
	.numbered-item {
		counter-increment: list-counter;
		line-height: 1.8;
	}
	
	.numbered-item::before {
		content: counter(list-counter);
		position: absolute;
		left: 0;
		top: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		background: rgb(var(--theme-accent) / 0.1);
		color: rgb(var(--theme-accent));
		border-radius: 50%;
		font-weight: 600;
		font-size: 0.875rem;
		transition: all 0.3s ease;
	}
	
	.numbered-item:hover::before {
		background: rgb(var(--theme-accent) / 0.2);
		transform: scale(1.1);
	}
	
	/* ネストされたリストのスタイル */
	.numbered-list .numbered-list {
		margin-top: 0.5rem;
		margin-bottom: 0.5rem;
	}
	
	.numbered-list .numbered-list .numbered-item::before {
		width: 1.5rem;
		height: 1.5rem;
		font-size: 0.75rem;
		background: rgb(var(--theme-accent-2) / 0.1);
		color: rgb(var(--theme-accent-2));
	}
	
	/* ダークモード対応 */
	:global(.dark) .numbered-item::before {
		background: rgba(255, 255, 255, 0.1);
		color: rgba(var(--theme-accent-2), 1);
	}
	
	:global(.dark) .numbered-item:hover::before {
		background: rgba(255, 255, 255, 0.15);
	}
	
	/* モバイル対応 */
	@media (max-width: 640px) {
		.numbered-list {
			padding-left: 0;
		}
		
		.numbered-item {
			padding-left: 2rem;
		}
		
		.numbered-item::before {
			width: 1.5rem;
			height: 1.5rem;
			font-size: 0.75rem;
		}
		
		.numbered-item:hover {
			transform: none;
		}
	}
</style>
