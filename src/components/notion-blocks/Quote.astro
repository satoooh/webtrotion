---
import * as interfaces from "@/lib/interfaces.ts";
import { getNotionColorToTailwindColor } from "@/lib/style-helpers.ts";
import RichText from "@/components/notion-blocks/RichText.astro";
import NotionBlocks from "@/components/NotionBlocks.astro";
import AnimatedSection from "@/components/AnimatedSection.astro";

export interface Props {
	block: interfaces.Block;
	renderChildren?: boolean; // Make this optional
	setId?: boolean;
}

const { block, renderChildren = true, setId = true } = Astro.props;
---

<AnimatedSection animation="fadeInLeft" delay={100}>
	<blockquote
		class:list={[
			"nquote my-8 border-l-4 border-accent/30 px-6 py-4 rounded-r-md bg-accent/5 shadow-sm transition-all duration-300 hover:shadow-md hover:border-accent/50",
			{
				[`rounded-md ${getNotionColorToTailwindColor(block.Quote.Color)}`]:
					block.Quote.Color &&
					!["default", "default_background", "default-background"].includes(block.Quote.Color),
			},
		]}
		id={setId ? block.Id : undefined}
	>
	<div class="relative">
		<svg class="absolute -top-2 -left-2 w-8 h-8 text-accent/20" fill="currentColor" viewBox="0 0 24 24">
			<path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
		</svg>
		<div class="pl-6 italic text-textColor/90">
			{
				block.Quote.RichTexts.map((richText: interfaces.RichText) => (
					<RichText richText={richText} blockID={block.Id} />
				))
			}
			{
				block.Quote.Children && renderChildren && (
					<NotionBlocks blocks={block.Quote.Children} renderChildren={renderChildren} setId={setId} />
				)
			}
		</div>
	</div>
	</blockquote>
</AnimatedSection>

<style>
	/* 引用ブロックのスタイル */
	.nquote {
		position: relative;
		overflow: hidden;
	}
	
	.nquote::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		bottom: 0;
		width: 4px;
		background: linear-gradient(to bottom, rgb(var(--theme-accent)), rgb(var(--theme-accent-2)));
		transition: width 0.3s ease;
	}
	
	.nquote:hover::before {
		width: 6px;
	}
	
	/* ダークモード対応 */
	:global(.dark) .nquote {
		background: rgba(255, 255, 255, 0.02);
		border-left-color: rgba(255, 255, 255, 0.2);
	}
	
	:global(.dark) .nquote svg {
		color: rgba(255, 255, 255, 0.1);
	}
	
	:global(.dark) .nquote:hover {
		background: rgba(255, 255, 255, 0.04);
		border-left-color: rgba(var(--theme-accent-2), 0.5);
	}
	
	/* モバイル対応 */
	@media (max-width: 640px) {
		.nquote {
			margin-top: 1.5rem;
			margin-bottom: 1.5rem;
			padding-left: 1rem;
			padding-right: 1rem;
		}
		
		.nquote svg {
			width: 1.5rem;
			height: 1.5rem;
			top: -0.25rem;
			left: -0.25rem;
		}
	}
</style>
