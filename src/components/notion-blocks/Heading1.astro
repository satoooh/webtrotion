---
import * as interfaces from "@/lib/interfaces.ts";
import { buildHeadingId } from "@/lib/blog-helpers.ts";
import RichText from "@/components/notion-blocks/RichText.astro";
import NotionBlocks from "@/components/NotionBlocks.astro";
import Icon from "@/components/Icon.astro";

export interface Props {
	block: interfaces.Block;
	renderChildren?: boolean; // Make this optional
	setId?: boolean;
}

const { block, renderChildren = true, setId = true } = Astro.props;

const id = buildHeadingId(block.Heading1);
---

{
	block.Heading1.IsToggleable ? (
		<details class="toggle mt-8 mb-0">
			<summary class="flex cursor-pointer list-none gap-2">
				<div>
					<Icon
						name={"toggle-triangle"}
						class="rotate-svg mt-1 h-6 w-6 shrink-0 transition-all duration-300"
						aria-label="Toggle open/close"
						stroke="currentColor"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
					/>
				</div>
				<span class="inline">
					<h2
						class={`heading-1 toggle-h2 mt-8 mb-1 inline cursor-pointer text-2xl font-semibold ${setId ? "hasId" : "noId"}`}
						id={setId ? id : undefined}
						onclick="
        var fullUrl = `${window.location.origin}${window.location.pathname}#${id}`;
        navigator.clipboard.writeText(fullUrl);
        window.history.pushState(null, '', fullUrl);
        document.getElementById(`${id}`).scrollIntoView({ behavior: 'smooth' });"
					>
						{block.Heading1.RichTexts.map((richText: interfaces.RichText) => (
							<RichText richText={richText} blockID={block.Id} />
						))}
					</h2>
				</span>
			</summary>
			<div class="pl-8">
				{block.Heading1.Children && renderChildren && (
					<NotionBlocks
						blocks={block.Heading1.Children}
						renderChildren={renderChildren}
						setId={setId}
					/>
				)}
			</div>
		</details>
	) : (
		<h2
			class={`heading-1 mt-8 mb-1 cursor-pointer text-2xl font-semibold ${setId ? "hasId" : "noId"}`}
			id={setId ? id : undefined}
			onclick="
        var fullUrl = `${window.location.origin}${window.location.pathname}#${id}`;
        navigator.clipboard.writeText(fullUrl);
        window.history.pushState(null, '', fullUrl);
        document.getElementById(`${id}`).scrollIntoView({ behavior: 'smooth' });"
		>
			{block.Heading1.RichTexts.map((richText: interfaces.RichText) => (
				<RichText richText={richText} blockID={block.Id} />
			))}
		</h2>
	)
}

<style>
	/* 見出しの洗練されたデザイン */
	.heading-1 {
		position: relative;
		padding-left: 0.75rem;
		transition: all 0.3s ease;
		border-bottom: 2px solid transparent;
		padding-bottom: 0.5rem;
	}
	
	.heading-1::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 4px;
		background: rgb(var(--theme-accent));
		opacity: 0.7;
		border-radius: 2px;
		transition: all 0.3s ease;
	}
	
	.heading-1:hover {
		padding-left: 1rem;
		color: rgb(var(--theme-accent));
	}
	
	.heading-1:hover::before {
		width: 5px;
		opacity: 1;
	}
	
	/* アンカーリンクのスタイル */
	h2.hasId::after {
		content: "#";
		position: absolute;
		color: rgba(var(--theme-accent), 0.4);
		margin-left: 0.5rem;
		display: inline-block;
		opacity: 0;
		transition: opacity 0.3s ease;
		font-weight: 400;
		font-size: 0.875em;
	}
	
	h2.noId::after {
		display: none;
	}

	h2.hasId:hover::after {
		opacity: 1;
	}
	
	.toggle-h2 {
		padding-left: 0;
	}
	
	.toggle-h2::before {
		display: none;
	}
	
	/* ダークモード対応 */
	:global(.dark) .heading-1 {
		border-bottom-color: rgba(255, 255, 255, 0.1);
	}
	
	:global(.dark) .heading-1:hover {
		color: rgb(var(--theme-accent-2));
	}
	
	details[open] > summary > div > .shrink-0.rotate-svg {
		transform: rotate(90deg);
	}
	
	summary::-webkit-details-marker {
		display: none;
	}
</style>
