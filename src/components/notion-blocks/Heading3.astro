---
import * as interfaces from "@/lib/interfaces.ts";
import { buildHeadingId } from "@/lib/blog-helpers.ts";
import RichText from "@/components/notion-blocks/RichText.astro";
import NotionBlocks from "@/components/NotionBlocks.astro";
import Icon from "@/components/Icon.astro";
export interface Props {
	block: interfaces.Block;
	renderChildren?: boolean; // Make this optional
	setId?: boolean;
}

const { block, renderChildren = true, setId = true } = Astro.props;

const id = buildHeadingId(block.Heading3);
---

{
	block.Heading3.IsToggleable ? (
		<details class="toggle mt-4 mb-1">
			<summary class="flex max-w-full cursor-pointer list-none gap-2">
				<div>
					<Icon
						name={"toggle-triangle"}
						class="rotate-svg mt-[2px] h-6 w-6 shrink-0 transition-all duration-300"
						aria-label="Toggle open/close"
						stroke="currentColor"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
					/>
				</div>
				<span class="inline">
					<h4
						class={`heading-3 toggle-h4 mt-4 mb-1 inline cursor-pointer text-lg font-semibold ${setId ? "hasId" : "noId"}`}
						id={setId ? id : undefined}
						onclick="
        var fullUrl = `${window.location.origin}${window.location.pathname}#${id}`;
        navigator.clipboard.writeText(fullUrl);
        window.history.pushState(null, '', fullUrl);
        document.getElementById(`${id}`).scrollIntoView({ behavior: 'smooth' });"
					>
						{block.Heading3.RichTexts.map((richText: interfaces.RichText) => (
							<RichText richText={richText} blockID={block.Id} />
						))}
					</h4>
				</span>
			</summary>
			<div class="pl-8">
				{block.Heading3.Children && renderChildren && (
					<NotionBlocks
						blocks={block.Heading3.Children}
						renderChildren={renderChildren}
						setId={setId}
					/>
				)}
			</div>
		</details>
	) : (
		<h4
			class={`heading-3 mt-4 mb-1 cursor-pointer text-lg font-semibold ${setId ? "hasId" : "noId"}`}
			id={setId ? id : undefined}
			onclick="
        var fullUrl = `${window.location.origin}${window.location.pathname}#${id}`;
        navigator.clipboard.writeText(fullUrl);
        window.history.pushState(null, '', fullUrl);
        document.getElementById(`${id}`).scrollIntoView({ behavior: 'smooth' });"
		>
			{block.Heading3.RichTexts.map((richText: interfaces.RichText) => (
				<RichText richText={richText} blockID={block.Id} />
			))}
		</h4>
	)
}

<style>
	/* 見出しの洗練されたデザイン */
	.heading-3 {
		position: relative;
		padding-left: 0.5rem;
		transition: all 0.3s ease;
	}
	
	.heading-3::before {
		content: '●';
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		color: rgba(var(--theme-accent), 0.4);
		font-size: 0.5em;
		transition: all 0.3s ease;
	}
	
	.heading-3:hover {
		padding-left: 0.75rem;
		color: rgb(var(--theme-accent));
	}
	
	.heading-3:hover::before {
		color: rgba(var(--theme-accent), 0.8);
		font-size: 0.625em;
	}
	
	/* アンカーリンクのスタイル */
	h4.hasId::after {
		content: "#";
		position: absolute;
		color: rgba(var(--theme-accent), 0.4);
		margin-left: 0.5rem;
		display: inline-block;
		opacity: 0;
		transition: opacity 0.3s ease;
		font-weight: 400;
		font-size: 0.875em;
	}
	
	h4.noId::after {
		display: none;
	}

	h4.hasId:hover::after {
		opacity: 1;
	}
	
	.toggle-h4 {
		padding-left: 0;
	}
	
	.toggle-h4::before {
		display: none;
	}
	
	/* ダークモード対応 */
	:global(.dark) .heading-3:hover {
		color: rgb(var(--theme-accent-2));
	}
	
	:global(.dark) .heading-3:hover::before {
		color: rgba(var(--theme-accent-2), 0.8);
	}
	
	details[open] > summary > div > .shrink-0.rotate-svg {
		transform: rotate(90deg);
	}
	
	summary::-webkit-details-marker {
		display: none;
	}
</style>
