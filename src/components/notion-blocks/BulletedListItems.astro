---
import * as interfaces from "@/lib/interfaces";
import { getNotionColorToTailwindColor } from "@/lib/style-helpers.ts";
import RichText from "@/components/notion-blocks/RichText.astro";
import NotionBlocks from "@/components/NotionBlocks.astro";

export interface Props {
	block: interfaces.Block;
	renderChildren?: boolean; // Make this optional
	setId?: boolean;
}

const { block, renderChildren = true, setId = true } = Astro.props;
---

<ul class="bulleted-list list-outside list-none space-y-3 pl-6 my-6 leading-[1.8]" id={setId?block.Id:undefined}>
	{
		block.ListItems.filter((b: interfaces.Block) => b.Type === "bulleted_list_item").map(
			(b: interfaces.Block) => (
				<li
					class:list={[
						"list-item relative pl-6 transition-all duration-300 hover:translate-x-1",
						{
							[`${getNotionColorToTailwindColor(b.BulletedListItem.Color)} rounded-sm px-2 py-1`]:
								b.BulletedListItem.Color &&
								!["default", "default_background", "default-background"].includes(
									b.BulletedListItem.Color,
								),
						},
					]}
					id={setId ? b.Id : undefined}
				>
					{b.BulletedListItem.RichTexts.map((richText: interfaces.RichText) => (
						<RichText richText={richText} blockID={b.Id} />
					))}
					{b.HasChildren && renderChildren && (
						<NotionBlocks
							blocks={b.BulletedListItem.Children}
							renderChildren={renderChildren}
							setId={setId}
						/>
					)}
				</li>
			),
		)
	}
</ul>

<style>
	/* カスタムブレットポイント */
	.list-item::before {
		content: '●';
		position: absolute;
		left: 0;
		top: 0.125em;
		color: rgb(var(--theme-accent));
		font-size: 0.875em;
		transition: all 0.3s ease;
	}
	
	.list-item:hover::before {
		transform: scale(1.2);
		color: rgb(var(--theme-accent-2));
	}
	
	/* ネストされたリスト */
	.bulleted-list .bulleted-list {
		margin-top: 0.5rem;
		margin-bottom: 0.5rem;
	}
	
	.bulleted-list .bulleted-list .list-item::before {
		content: '○';
		font-size: 0.75em;
	}
	
	.bulleted-list .bulleted-list .bulleted-list .list-item::before {
		content: '▪';
		font-size: 0.625em;
	}
	
	/* ダークモード対応 */
	:global(.dark) .list-item::before {
		color: rgba(var(--theme-accent-2), 0.8);
	}
	
	:global(.dark) .list-item:hover::before {
		color: rgb(var(--theme-accent-2));
	}
	
	/* モバイル対応 */
	@media (max-width: 640px) {
		.bulleted-list {
			padding-left: 1rem;
			space-y: 0.5rem;
		}
		
		.list-item {
			padding-left: 1.25rem;
		}
		
		.list-item:hover {
			transform: none;
		}
	}
</style>
