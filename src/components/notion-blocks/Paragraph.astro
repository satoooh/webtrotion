---
import * as interfaces from "@/lib/interfaces.ts";
import { getNotionColorToTailwindColor } from "@/lib/style-helpers.ts";
import RichText from "@/components/notion-blocks/RichText.astro";
import NotionBlocks from "@/components/NotionBlocks.astro";
import AnimatedSection from "@/components/AnimatedSection.astro";

export interface Props {
	block: interfaces.Block;
	renderChildren?: boolean;
	setId?: boolean;
}

const { block, renderChildren = true, setId = true } = Astro.props;

const hasChildren = block.Paragraph.Children && block.Paragraph.Children.length > 0;
const Tag = hasChildren && renderChildren ? "div" : "p";
---

<AnimatedSection animation="fadeIn" delay={50}>
	<Tag
		class:list={[
			"paragraph my-6 min-h-7 text-[1.05rem] leading-[1.8] tracking-[0.01em] text-textColor transition-colors duration-300",
			{
				[`${getNotionColorToTailwindColor(block.Paragraph.Color)} rounded-sm px-3 py-1`]:
					block.Paragraph.Color &&
					!["default", "default_background", "default-background"].includes(block.Paragraph.Color),
			},
		]}
		id={setId ? block.Id : undefined}
	>
		{block.Paragraph.RichTexts.map((richText) => <RichText richText={richText} blockID={block.Id} />)}
		{block.Paragraph.RichTexts.length === 0 && <br />}
		{
			hasChildren && renderChildren && (
				<div class="pl-6">
					<NotionBlocks
						blocks={block.Paragraph.Children}
						setId={setId}
						renderChildren={renderChildren}
					/>
				</div>
			)
		}
	</Tag>
</AnimatedSection>

<style>
	/* 段落の読みやすさ向上 */
	.paragraph {
		font-feature-settings: "kern" 1, "liga" 1;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}
	
	
	/* リンクのホバー効果 */
	.paragraph :global(a) {
		position: relative;
		transition: color 0.3s ease;
	}
	
	.paragraph :global(a)::after {
		content: '';
		position: absolute;
		bottom: -2px;
		left: 0;
		width: 0;
		height: 2px;
		background: rgb(var(--theme-accent));
		transition: width 0.3s ease;
	}
	
	.paragraph :global(a:hover)::after {
		width: 100%;
	}
	
	/* ダークモード対応 */
	:global(.dark) .paragraph {
		color: rgba(255, 255, 255, 0.9);
	}
	
	/* モバイル対応 */
	@media (max-width: 640px) {
		.paragraph {
			font-size: 0.975rem;
			line-height: 1.75;
			margin-top: 1rem;
			margin-bottom: 1rem;
		}
	}
</style>
